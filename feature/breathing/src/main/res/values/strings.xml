<resources>
    <!-- Breathing and relaxation -->
    <string name="breathing_title">Breathing and relaxation</string>
    <string name="breathing_intro">Short guided breathing to settle, or to wind down before bed. Follow the circle: it grows as you breathe in and shrinks as you breathe out.</string>
    <string name="breathing_session_calm">Calm breathing</string>
    <string name="breathing_session_calm_body">A slightly longer out-breath, to settle in a minute.</string>
    <string name="breathing_session_box">Box breathing</string>
    <string name="breathing_session_box_body">Four equal parts: in, hold, out, hold. Steady and even.</string>
    <string name="breathing_session_four_seven_eight">4-7-8 breathing</string>
    <string name="breathing_session_four_seven_eight_body">A long, slow out-breath. A calm choice for the evening.</string>

    <!-- Andning och återhämtning -->
    <string name="breathing_title">Andning och avslappning</string>
    <string name="breathing_intro">Korta guidade andningsövningar för att landa, eller för att varva ner inför natten. Följ cirkeln: den växer när du andas in och krymper när du andas ut.</string>
    <string name="breathing_session_calm">Lugn andning</string>
    <string name="breathing_session_calm_body">En aning längre utandning, för att landa på en minut.</string>
    <string name="breathing_session_box">Boxandning</string>
    <string name="breathing_session_box_body">Fyra lika långa delar: in, håll, ut, håll. Jämnt och lugnt.</string>
    <string name="breathing_session_four_seven_eight">4-7-8-andning</string>
    <string name="breathing_session_four_seven_eight_body">En lång, långsam utandning. Ett lugnt val för kvällen.</string>
    <string name="breathing_duration_about">Cirka %1$s</string>

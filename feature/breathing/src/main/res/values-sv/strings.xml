    <string name="breathing_duration_seconds">%1$d s</string>
    <string name="breathing_duration_minutes_seconds">%1$d min %2$d s</string>
    <string name="breathing_start">Börja</string>
    <string name="breathing_start_session">Börja %1$s</string>
    <string name="breathing_round">Runda %1$d av %2$d</string>
    <string name="breathing_remaining">%1$s kvar</string>
    <string name="breathing_phase_inhale">Andas in</string>
    <string name="breathing_phase_hold_in">Håll</string>
    <string name="breathing_phase_exhale">Andas ut</string>
    <string name="breathing_phase_hold_out">Håll</string>
    <string name="breathing_pause">Pausa</string>
    <string name="breathing_resume">Fortsätt</string>
    <string name="breathing_restart">Börja om</string>
    <string name="breathing_done_title">Övningen är klar</string>
    <string name="breathing_done_body">Stanna en stund och känn efter.</string>
    <string name="breathing_note">Andas bekvämt i din egen takt. Räkningen är en ledtråd, inte ett mål. Blir du yr eller andfådd, avbryt och andas som vanligt.</string>
    <string name="breathing_footer">Novila sparar inte dina övningar. De är stunder för dig, inte en poäng.</string>

<?xml version="1.0" encoding="utf-8"?>
<!--
  The home-screen widget. The receiver ends up in app/badging/debug-badging.txt: it must be exported, since the
  launcher (through the system) sends it the widget's updates. It reads nothing from the intent but the widget ids, and
  only shows what the app already saves on the phone.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <receiver
            android:name="se.novila.feature.widget.NovilaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/novila_widget_info" />
        </receiver>

        <!--
          The Quick Settings tile that logs a glass of water. Exported, as every tile is, so the system can bind it, but
          only for holders of BIND_QUICK_SETTINGS_TILE, which only the system UI has. It reads nothing from the
          system but the tap, and asks to unlock first on the lock screen. It ends up in app/badging/debug-badging.txt.
        -->
        <service
            android:name="se.novila.feature.widget.WaterTileService"
            android:exported="true"
            android:icon="@drawable/ic_water"
            android:label="@string/tile_water_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Glance's service for lists in widgets (LazyColumn), exported to the launcher. The widget has no lists, so the
          service is removed and the APK doesn't export what it never uses.
        -->
        <service
            android:name="androidx.glance.appwidget.GlanceRemoteViewsService"
            tools:node="remove" />
    </application>
</manifest>

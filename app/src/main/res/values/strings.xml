    <string name="health_info_why_title">Why</string>
    <string name="health_info_why_body">To show how much you have moved today on the Today dashboard and under Training.</string>
    <string name="health_info_where_title">Where the data goes</string>
    <string name="health_info_where_body">Nowhere. Novila reads the numbers while the app is open and only shows them. They are not saved by Novila, not sent over the internet and not shared with anyone.</string>

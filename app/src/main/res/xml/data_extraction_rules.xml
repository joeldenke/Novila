<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android Auto Backup and device-to-device transfer copy on Android 12 (API 31) and newer.
  Older versions use backup_rules.xml; both files must stay in sync.

  Novila stores health data on the device only, so nothing is copied to Google Drive or handed to a
  new phone. Every domain is excluded, which covers :core:data's encrypted Preferences DataStore
  files (files/datastore/), the legacy SharedPreferences of the same names, their Tink keyset, and
  WorkManager's database. The keyset is sealed with the Android Keystore's master key, which cannot
  be backed up, so a restored copy could not be read here anyway.

  allowBackup stays "true": the exclusion is explicit, and turning it off also disables the
  device-transfer channel some users rely on. See docs/backup.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>

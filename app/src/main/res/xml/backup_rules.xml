<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android Auto Backup copies on Android 11 (API 30) and older. Android 12 and newer use
  data_extraction_rules.xml (see that file for why nothing is copied); both must stay in sync.

  Every domain is excluded, so no health data leaves the device.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>

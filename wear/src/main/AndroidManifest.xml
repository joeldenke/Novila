<?xml version="1.0" encoding="utf-8"?>
<!--
  The Wear OS companion is a separate app (`se.novila.wear`): it does not share data with the phone app yet, so it
  needs no permissions and no network. It only shows a strength session and its timer, from the shared workout
  logic in :core:exercise. See docs/roadmap.md and CLAUDE.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />

    <application
        android:name=".WearApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_wear_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">
        <!-- Independent of the phone app: no data is shared with it yet. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />
        <activity
            android:name=".WearActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
